table Charging
	lineageTag: 35f64c59-469a-4e5e-b453-23137a9f351f

	measure Scenarios = COUNTROWS ( Charging )
		formatString: 0
		lineageTag: 839a599b-30cc-41ae-9661-9504a9f6648f

	measure 'Carbon saving %' =
			
			DIVIDE (
			    SUM ( Charging[immediate_kg] ) - SUM ( Charging[scheduled_kg] ),
			    SUM ( Charging[immediate_kg] )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b531bb28-65b2-44de-b86f-6d8350ea15bb

	measure 'Win rate' =
			
			DIVIDE (
			    CALCULATE ( COUNTROWS ( Charging ), Charging[result] = "Scheduled better" ),
			    COUNTROWS ( Charging )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f1e1c516-52d2-4013-9fdc-7726c0d5e141

	measure 'Share of best possible saving' =
			
			DIVIDE (
			    SUM ( Charging[immediate_kg] ) - SUM ( Charging[scheduled_kg] ),
			    SUM ( Charging[immediate_kg] ) - SUM ( Charging[perfect_information_kg] )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d4b3ef9e-0f1a-41e7-9fa1-171c5f03dc2e

	measure 'Avg immediate kg' = AVERAGE ( Charging[immediate_kg] )
		formatString: 0.00
		lineageTag: 6d6fe691-9eb8-4044-aaab-3a28e2c71001

	measure 'Avg scheduled kg' = AVERAGE ( Charging[scheduled_kg] )
		formatString: 0.00
		lineageTag: cb2ab8a9-dfdf-4b42-89bd-09b4ea37b284

	measure 'Total saving kg' = SUM ( Charging[saving_kg] )
		formatString: 0.00
		lineageTag: 7fc9b3e6-5396-43be-b17c-63425b670cf0

	column scenario_start_utc
