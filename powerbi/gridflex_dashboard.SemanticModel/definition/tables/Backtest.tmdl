table Backtest
	lineageTag: 6019e54e-167e-4873-b926-332710ee014a

	measure MAE = AVERAGE ( Backtest[abs_error] )
		formatString: 0.00
		lineageTag: 85a97129-6b07-48f1-8a55-2dadbf5d381b

	measure RMSE = SQRT ( AVERAGE ( Backtest[squared_error] ) )
		formatString: 0.00
		lineageTag: 1f9547e8-fbc4-401d-9cb2-53a1e52afa2d

	measure 'Interval coverage' =
			
			DIVIDE ( SUM ( Backtest[inside_interval] ), COUNT ( Backtest[inside_interval] ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0aa2b442-a0be-49ff-95aa-19c2bb993208

	measure 'MAE vs live model' =
			
			[MAE] - CALCULATE ( [MAE], Backtest[model] = "Seven-day mean (live)" )
		formatString: 0.00
		lineageTag: 3a8ebaed-d023-4aae-bf2e-6ab7f2dc6704

	measure 'Forecasts per model' =
			
			CALCULATE ( COUNTROWS ( Backtest ), Backtest[model] = "LightGBM (candidate)" )
		formatString: #,0
		lineageTag: 11e58d65-0452-48ad-9cd1-61747eb334b6

